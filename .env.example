# Interface the web UI and HTTP MCP endpoint bind to. Keep it on loopback:
# Shaky has no authentication.
SHAKY_HOST=127.0.0.1
SHAKY_PORT=8787

# Where the SQLite database lives. Defaults to the per-user data directory:
#   Windows: %APPDATA%\shaky
#   macOS:   ~/Library/Application Support/shaky
#   Linux:   $XDG_DATA_HOME/shaky (or ~/.local/share/shaky)
# SHAKY_DATA_DIR=

# Set to false so `shaky mcp` never starts the web UI alongside stdio.
SHAKY_WEB_AUTOSTART=true
