{
  "name": "shaky-mcp",
  "version": "1.3.0",
  "description": "Shaky, your local AI bartender: an MCP server that knows exactly what is in your home bar, plus a playful web UI on localhost.",
  "type": "module",
  "license": "MIT",
  "author": "akquisio-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akquisio-dev/Shaky-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cocktails",
    "bar",
    "bartender",
    "sqlite"
  ],
  "bin": {
    "shaky": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "build:client": "vite build",
    "start": "node dist/cli.js serve",
    "seed": "node dist/cli.js seed",
    "doctor": "node dist/cli.js doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check . && npm run typecheck",
    "format": "prettier --write . && eslint . --fix"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
